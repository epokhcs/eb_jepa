# Weights & Biases API Key
# Get your API key from https://wandb.ai/authorize
# If set, wandb logging will be automatically enabled
WANDB_API_KEY=

# SSL Certificate Verification (true/false)
# Set to false if you encounter SSL certificate errors with W&B
# Default: true (recommended for security)
WANDB_VERIFY_SSL=true

# Optional: Set to 'disabled' to disable wandb even if API key is present
# WANDB_MODE=disabled
